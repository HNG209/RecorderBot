# ==============================================================================
# LiveKit Configuration
# ==============================================================================
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ==============================================================================
# Cloudflare R2 Storage Configuration (S3-compatible)
# ==============================================================================
# Your Cloudflare Account ID (found in Cloudflare dashboard -> R2 overview)
R2_ACCOUNT_ID=your_cloudflare_account_id

# Cloudflare R2 API Tokens (Access Key ID & Secret Access Key with Read/Write permission)
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# The name of your R2 Bucket
R2_BUCKET_NAME=your_r2_bucket_name

# Endpoint URL is auto-generated as https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# if R2_ENDPOINT_URL is left empty.
R2_ENDPOINT_URL=

# Public access domain/URL (e.g. https://pub-xxxx.r2.dev or your custom domain https://media.yourdomain.com)
# Optional - leave empty if not using public access
R2_PUBLIC_URL=

# ==============================================================================
# Bot & Server Configuration
# ==============================================================================
RECORDINGS_DIR=recordings
HOST=0.0.0.0
PORT=8000

# ==============================================================================
# Webhook Configuration
# ==============================================================================
# URL backend nhận webhook khi phiên ghi hoàn tất và đã upload lên Cloudflare R2
WEBHOOK_URL=http://localhost:3000/api/recordings/webhook
